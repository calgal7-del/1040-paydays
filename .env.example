# PostgreSQL connection string for the subscriber database.
# Use a Vercel Postgres, Neon, Supabase, or other hosted PostgreSQL DATABASE_URL.
DATABASE_URL="postgres://user:password@host:5432/database"

# Leave true/default for hosted PostgreSQL providers that require SSL.
# Set to false only for a trusted local database.
DATABASE_SSL="true"

# Secret used to hash confirmation tokens before storage.
# Use a long random value in production.
CONFIRMATION_TOKEN_SECRET="replace-with-a-long-random-secret"

# Secret used to hash rate-limit identifiers so raw IP addresses are never stored.
# Use a long random value in production.
RATE_LIMIT_SECRET="replace-with-a-different-long-random-secret"

# Optional abuse controls.
SUBSCRIBE_RATE_LIMIT_WINDOW_SECONDS="900"
SUBSCRIBE_RATE_LIMIT_MAX="5"
SUBSCRIBE_CONFIRMATION_TOKEN_TTL_HOURS="48"
